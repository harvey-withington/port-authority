{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "go: build pactl",
      "type": "shell",
      "command": "go build -o bin/pactl.exe ./cmd/pactl",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$go"]
    },
    {
      "label": "go: test all",
      "type": "shell",
      "command": "go test ./...",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$go"]
    },
    {
      "label": "go: vet all",
      "type": "shell",
      "command": "go vet ./...",
      "problemMatcher": ["$go"]
    },
    {
      "label": "wails: build desktop app",
      "type": "shell",
      "command": "wails build",
      "problemMatcher": ["$go"]
    },
    {
      "label": "wails: build debug",
      "type": "shell",
      "command": "wails build -debug -devtools",
      "problemMatcher": ["$go"]
    },
    {
      "label": "wails: dev (hot reload)",
      "type": "shell",
      "command": "wails dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "kb: sync from usb-device-kb",
      "type": "shell",
      "command": "go run ./tools/syncdata",
      "problemMatcher": []
    },
    {
      "label": "frontend: check + test",
      "type": "shell",
      "command": "npm run check && npm run test:run",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    }
  ]
}
